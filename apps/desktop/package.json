{
  "name": "vpsgogo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "dev:ios": "mygo dev -platform ios",
    "dev:android": "mygo dev -platform android",
    "build": "mygo build",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "dev:mock": "vite --mode mock",
    "build:web:mock": "tsc --noEmit && vite build --mode mock --outDir dist-mock",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "mygo-runtime": "^0.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "mygo-cli": "^0.10.0",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5.1.2"
  }
}
